%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da3571184c886394088648833b71ce92, type: 3}
  m_Name: Dialogue_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLines
  lines:
  - text: Hello there! You must be employee 265!
    audio: {fileID: 8300000, guid: e4ef78f5043c3df4c94de8adb5a2d710, type: 3}
    showContinueButton: 1
  - text: I am S.A.M, your Supervisionary Assitant Module. I will be here to help
      you settle into your new role.
    audio: {fileID: 8300000, guid: 353d39fb75e03484f88de6518bbf6223, type: 3}
    showContinueButton: 1
  - text: Here at SlimeCo we deliver friendly slimes that produce positive emotions
      for our customers.
    audio: {fileID: 8300000, guid: 174dfd965457f91489fe5e4a4ba889e2, type: 3}
    showContinueButton: 1
  - text: Living in a dying dystopian world can be depressing and gloomy. We at SlimeCo
      believe a better tomorrow lies within.
    audio: {fileID: 8300000, guid: a49870a3a73356e46aabe0cfc2a885ae, type: 3}
    showContinueButton: 1
  - text: You job is to sort any sad slimes out from the good ones.
    audio: {fileID: 8300000, guid: 19922bbb1b2603a4e9c325fc2f00aa43, type: 3}
    showContinueButton: 1
  - text: Put good slimes in the right tube and bad slimes in the left.
    audio: {fileID: 8300000, guid: eaee6b642b22fae49a8ef37a5320a735, type: 3}
    showContinueButton: 1
  - text: Pretty simple for such good pay!
    audio: {fileID: 8300000, guid: 23e08c6484d306a4d90342888d3aafa3, type: 3}
    showContinueButton: 1
