  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da3571184c886394088648833b71ce92, type: 3}
  m_Name: Dialogue_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLines
  lines:
  - text: Hello there! You must be employee 265!
    audio: {fileID: 8300000, guid: 52ddf2c1996d74f41bffdb8a9df37892, type: 3}
  - text: I am S.A.M, your Supervisionary Assitant Module. I will be here to help
      you settle into your new role.
    audio: {fileID: 8300000, guid: 9b94074f1b0ad5f46abc710273f85b77, type: 3}
  - text: Here at SlimeCo we deliver friendly slimes that produce positive emotions
      for our customers.
    audio: {fileID: 8300000, guid: 1b9fbe6599e36454581c8692a6e072a8, type: 3}
  - text: Living in a dying dystopian world can be depressing and gloomy. We at SlimeCo
      believe a better tomorrow lies within.
    audio: {fileID: 8300000, guid: e66720cca937ea24b9d59ce46ac56c7c, type: 3}
  - text: You job is to sort any sad slimes out from the good ones.
    audio: {fileID: 8300000, guid: 2c16fc97211c8ae49abf2522c8c38e95, type: 3}
  - text: Put good slimes in the left tube and bad slimes in the right
    audio: {fileID: 8300000, guid: 71f677b225db6e64da7852352ff993a4, type: 3}
  - text: Pretty simple for such good pay!
    audio: {fileID: 8300000, guid: 6a9a6f80611d2ca42b752048e4cc6be0, type: 3}
